PORT=8087
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/hallpark

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

CORS_ORIGINS=*

# Cloudinary — for FAQ video uploads (signed direct upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=halapark/faq-videos


# Email forwarding of website submissions (contact, quotes, partner requests,
# job applications, proposals, consultations). Use EITHER Brevo (preferred)
# OR SMTP; leave both empty to disable.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HalaPark Website
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HalaPark Website <no-reply@halapark.com>"
NOTIFY_EMAIL=support@halapark.com
# MAIL_DRY_RUN=true logs the rendered email instead of sending (local testing)
MAIL_DRY_RUN=false
